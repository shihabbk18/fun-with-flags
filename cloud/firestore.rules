rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verifiedOwner(uid) {
   return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
  }
  function validResult(id) {
   let d = request.resource.data;
   return d.keys().hasAll(['id','created','mode','region','correct','total','seconds','points','moves','report','payload'])
    && d.keys().hasOnly(['id','created','mode','region','correct','total','seconds','points','moves','report','payload'])
    && id.matches('^[a-f0-9-]{36}$') && d.id == id
    && d.created is int && d.created > 0
    && d.mode in ['flag','capital','continent','sprint','memory']
    && d.region is string && d.region.size() <= 100
    && d.correct is int && d.total is int && d.total >= 0 && d.total <= 250
    && d.correct >= 0 && d.correct <= d.total
    && d.seconds is int && d.seconds >= 0 && d.seconds <= 604800
    && d.points is int && d.points == d.correct * 10
    && d.moves is int && d.moves >= 0 && d.moves <= 100000
    && d.report is string && d.report.size() <= 32768
    && d.payload is string && d.payload.size() <= 80000;
  }
  match /users/{uid}/results/{id} {
   allow read: if verifiedOwner(uid);
   allow create: if verifiedOwner(uid) && validResult(id);
   allow update: if verifiedOwner(uid) && validResult(id) && request.resource.data == resource.data;
   allow delete: if verifiedOwner(uid);
  }
  match /{document=**} {allow read, write: if false;}
 }
}
